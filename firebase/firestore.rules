rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 선정초안작성기 — Firestore 규칙
//
// 게시 위치: Firestore 화면 상단에서 데이터베이스 'choice' 를 고른 뒤 [규칙] 탭.
//            (public/config.json 의 firebase.databaseId 와 같아야 함)
//
// 이 앱이 서버에 두는 자료는 학교별 '선정 대상 과목'과 '과목별 출판사'뿐이다.
// 위원 개인 평가표·점수·의견·총괄표는 각자의 컴퓨터에만 저장되며 여기로 오지 않는다.
//
//  · 교사      : 가입 없이 학교 아이디로 문서 1건을 읽기만 한다.
//  · 담당 교사 : 이메일·비밀번호로 가입한 계정(ownerUid)만 자기 학교 문서를 고치고 지운다.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    match /schools/{schoolId} {
      // 학교 아이디를 아는 사람은 그 학교 문서 1건을 읽을 수 있다 (목록 조회는 막는다)
      allow get: if true;
      allow list: if false;

      // 가입한 계정이 자기 uid 로 학교를 만든다. 아이디 1개 = 학교 1곳.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.schoolId == schoolId
                    && request.resource.data.keys().hasOnly(['schoolId', 'schoolName', 'ownerUid', 'subjects', 'publishers', 'createdAt', 'updatedAt']);

      // 수정·삭제는 만든 사람만. 소유자는 바꿀 수 없다.
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // 그 밖의 문서는 모두 차단 (예전 구조에서 쓰던 컬렉션 포함)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
