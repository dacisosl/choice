rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 선정초안작성기 — Firestore 규칙
//
// 게시 위치: Firestore 화면 상단에서 데이터베이스 'choice' 를 고른 뒤 [규칙] 탭.
//            (public/config.json 의 firebase.databaseId 와 같아야 함)
//
// 이 앱이 서버에 두는 자료는 학교별 '선정 대상 과목'과 '과목별 출판사'뿐이다.
// 위원 개인 평가표·점수·의견·총괄표는 각자의 컴퓨터에만 저장되며 여기로 오지 않는다.
//
//  · 교사    : 가입 없이 학교 아이디로 문서 1건을 읽기만 한다.
//  · 담당 교사: 이메일·비밀번호로 가입한 계정(ownerUid)만 자기 학교 문서를 고치고 지운다.
//  · 운영자  : 아래 isSuperAdmin() 의 구글 계정. 학교 아이디 목록(school_index)을 보고 지울 수 있다.
//              schools 컬렉션은 목록 조회가 막혀 있어 운영자도 과목·출판사를 훑어볼 수 없다.
//              (public/config.json 의 firebase.superAdmins 와 같은 주소를 적어야 한다)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email in ['schoooolid@gmail.com'];
    }

    match /schools/{schoolId} {
      // 학교 아이디를 아는 사람은 그 학교 문서 1건을 읽을 수 있다
      allow get: if true;
      // 목록 조회는 아무도 할 수 없다 (운영자 포함)
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.schoolId == schoolId
                    && request.resource.data.keys().hasOnly(['schoolId', 'schoolName', 'ownerUid', 'subjects', 'publishers', 'createdAt', 'updatedAt']);

      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if (request.auth != null && resource.data.ownerUid == request.auth.uid) || isSuperAdmin();
    }

    // 학교 아이디 목록 (아이디·학교명·담당자 이메일·날짜만. 과목·출판사 내용은 없음)
    match /school_index/{schoolId} {
      // 담당자 이메일이 들어 있으므로 본인과 운영자만 읽는다
      // (가입할 때 아이디 중복 확인은 schools/{id} 로 하므로 공개 읽기가 필요 없다)
      allow get: if isSuperAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow list: if isSuperAdmin();            // 전체 목록은 운영자만
      allow create, update: if request.auth != null
                           && (request.resource.data.ownerUid == request.auth.uid
                               || (resource != null && resource.data.ownerUid == request.auth.uid));
      allow delete: if (request.auth != null && resource.data.ownerUid == request.auth.uid) || isSuperAdmin();
    }

    // 그 밖의 문서는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
