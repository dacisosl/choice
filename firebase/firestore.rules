rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 선정초안작성기 — Firestore 규칙
//
// 게시 위치: Firestore 화면 상단에서 데이터베이스 'choice' 를 고른 뒤 [규칙] 탭.
//            (public/config.json 의 firebase.databaseId 와 같아야 함)
//
// 권한 요약
//  · 일반 교사  : 구글 로그인 없이 익명 세션으로 접속. 마스터 데이터를 읽고,
//                본인 uid로 만든 개인 제출본(evaluation)만 읽기·쓰기·삭제.
//  · 승인 구성원: 구글 로그인 + 관리자 승인. 전체 목록 조회와 총괄표(summary) 작성.
//  · 관리자     : 마스터 데이터 수정, 회원 승인, 모든 문서 관리.
//  · 최초 관리자: isOwner() 의 이메일. 명단에 없어도 항상 관리자.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // 최초 관리자 (public/config.json 의 firebase.ownerEmail 과 같아야 함)
    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'schoooolid@gmail.com';
    }
    function memberPath() {
      return /databases/$(database)/documents/choice_members/$(request.auth.uid);
    }
    function memberData() {
      return get(memberPath()).data;
    }
    function isApproved() {
      return isOwner() || (isSignedIn() && exists(memberPath()) && memberData().status == 'approved');
    }
    function isAdmin() {
      return isOwner() || (isApproved() && memberData().role == 'admin');
    }
    // 문서 최상위 uid 가 현재 사용자와 같은가 (익명 세션 포함)
    function mine(d) {
      return isSignedIn() && d.uid == request.auth.uid;
    }

    // 구성원 명단: 본인 문서는 스스로 만들되 대기 상태로만, 승인·권한 변경은 관리자만
    match /choice_members/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'member';
      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /choice_docs/{docId} {
      // 마스터(과목·출판사·평가기준)는 서식을 채우는 데 필요하므로 접속자 모두 읽기 가능.
      // 개인 제출본은 본인 것만, 그 외 문서는 승인된 구성원만 읽는다.
      allow get: if isSignedIn() && (docId == 'master' || isApproved() || mine(resource.data));

      // 목록 조회(다른 교사의 제출본 열람)는 승인된 구성원만.
      // 로그인하지 않은 교사는 브라우저에 보관한 문서 id로 개별 조회만 한다.
      allow list: if isApproved();

      allow create: if isAdmin()
                    || (isApproved() && request.resource.data.kind == 'summary')
                    || (request.resource.data.kind == 'evaluation' && mine(request.resource.data));

      allow update: if isAdmin()
                    || (isApproved() && resource.data.kind == 'summary' && request.resource.data.kind == 'summary')
                    || (resource.data.kind == 'evaluation' && mine(resource.data) && mine(request.resource.data));

      allow delete: if isAdmin()
                    || (isApproved() && resource.data.kind == 'summary')
                    || (resource.data.kind == 'evaluation' && mine(resource.data));
    }
  }
}
